#include "../src/Resource.h"

IDI_APPICON ICON "tpmate.ico"

1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TPMate"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "TPMate"
            VALUE "ProductVersion", "0.1.0"
            VALUE "OriginalFilename", "TPMate.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
