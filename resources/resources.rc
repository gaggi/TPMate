#include "../src/Resource.h"

// The version numbers come from CMakeLists.txt (TPMATE_VERSION_DEFAULT).

IDI_APPICON ICON "tpmate.ico"

1 VERSIONINFO
 FILEVERSION TPMATE_VERSION_MAJOR, TPMATE_VERSION_MINOR, TPMATE_VERSION_PATCH, 0
 PRODUCTVERSION TPMATE_VERSION_MAJOR, TPMATE_VERSION_MINOR, TPMATE_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TPMate"
            VALUE "FileVersion", TPMATE_VERSION
            VALUE "ProductName", "TPMate"
            VALUE "ProductVersion", TPMATE_VERSION
            VALUE "OriginalFilename", "TPMate.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
